From ab24ced82e999dfaf05dfee46f6da50ca2c0561f Mon Sep 17 00:00:00 2001
From: Xinya Zhang <Xinya.Zhang@amd.com>
Date: Fri, 30 Oct 2026 22:47:01 +0000
Subject: [PATCH] flash: make empty composed offsets one-element tensors for
 Triton 3.9

https://github.com/ROCm/aotriton/commit/ab24ced82e999dfaf05dfee46f6da50ca2c0561f

composed_offs_1d returned a scalar 0 for an empty part (D1 or D2 == 0),
and composed_ptrs/composed_load index it with [None, :]. Triton 3.8
broadcast the scalar to shape [1]; Triton 3.9 rejects it with "too many
indices for tensor of rank 0". gfx1250 only has power-of-two head dims,
so D1 and D2 are always 0 and every gfx1250 kernel failed to compile.

Return tl.zeros([1], dtype=tl.int32) instead, the shape 3.8 produced.

Needed for gfx1250 with Triton 3.9; no other arch is built with 3.9 in
this cycle. Under Triton 3.8, 33 sampled rules (every kernel source,
gfx1250 and gfx942, incl. non-power-of-two head dims) give hsacos
byte-identical to before once debug info is stripped. Under Triton 3.9,
all 1389 gfx1250 rules and 300 random gfx942 rules compile.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tritonsrc/composed_tensors.py | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/tritonsrc/composed_tensors.py b/tritonsrc/composed_tensors.py
--- a/tritonsrc/composed_tensors.py
+++ b/tritonsrc/composed_tensors.py
@@ -13,9 +13,11 @@ def composed_offs_1d(
         D1 : tl.constexpr,
         D2 : tl.constexpr
 ):
-    x = tl.arange( 0 +  0, D0 +  0 +  0) if D0 > 0 else 0
-    y = tl.arange( 0 + D0, D0 + D1 +  0) if D1 > 0 else 0
-    z = tl.arange(D0 + D1, D0 + D1 + D2) if D2 > 0 else 0
+    # An empty part is a one-element zero, not a scalar 0: callers index it with
+    # [None, :], which Triton 3.9 rejects on a scalar (3.8 broadcast it to [1]).
+    x = tl.arange( 0 +  0, D0 +  0 +  0) if D0 > 0 else tl.zeros([1], dtype=tl.int32)
+    y = tl.arange( 0 + D0, D0 + D1 +  0) if D1 > 0 else tl.zeros([1], dtype=tl.int32)
+    z = tl.arange(D0 + D1, D0 + D1 + D2) if D2 > 0 else tl.zeros([1], dtype=tl.int32)
     return (x, y, z)
 
 
